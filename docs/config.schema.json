{
  "$id": "https://raw.githubusercontent.com/jongio/dispatch/main/docs/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema for Dispatch user configuration.",
  "properties": {
    "active_view": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "ai_search": {
      "type": "boolean"
    },
    "attention_threshold": {
      "description": "Positive Go duration such as 15m or 1h.",
      "type": "string"
    },
    "auto_refresh_seconds": {
      "type": "integer"
    },
    "config_version": {
      "type": "integer"
    },
    "conversation_newest_first": {
      "type": "boolean"
    },
    "custom_command": {
      "type": "string"
    },
    "default_collapsed": {
      "type": "boolean"
    },
    "default_pivot": {
      "enum": [
        "none",
        "folder",
        "repo",
        "branch",
        "date",
        "host"
      ],
      "type": "string"
    },
    "default_shell": {
      "type": "string"
    },
    "default_sort": {
      "enum": [
        "updated",
        "created",
        "turns",
        "name",
        "folder",
        "frecency"
      ],
      "type": "string"
    },
    "default_sort_order": {
      "enum": [
        "asc",
        "desc"
      ],
      "type": "string"
    },
    "default_terminal": {
      "type": "string"
    },
    "default_time_range": {
      "enum": [
        "1h",
        "1d",
        "7d",
        "all"
      ],
      "type": "string"
    },
    "excluded_dirs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "excluded_words": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "favoriteSessions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "hiddenSessions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "hidden_columns": {
      "items": {
        "enum": [
          "repo",
          "folder",
          "turns",
          "host"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "keybindings": {
      "additionalProperties": {
        "description": "Comma-separated key list.",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "up",
          "down",
          "jump_top",
          "jump_bottom",
          "left",
          "right",
          "enter",
          "space",
          "quit",
          "force_quit",
          "search",
          "escape",
          "filter",
          "sort",
          "sort_order",
          "pivot",
          "pivot_order",
          "preview",
          "preview_fullscreen",
          "reindex",
          "help",
          "config",
          "time_range_1",
          "time_range_2",
          "time_range_3",
          "time_range_4",
          "hide",
          "toggle_hidden",
          "star",
          "launch_window",
          "launch_tab",
          "launch_pane",
          "preview_scroll_up",
          "preview_scroll_down",
          "preview_next_match",
          "preview_prev_match",
          "open_related",
          "jump_next_attention",
          "filter_attention",
          "launch_all",
          "select_all",
          "deselect_all",
          "conversation_sort",
          "preview_position",
          "launch_set_save",
          "launch_set_list",
          "launch_set_rename",
          "launch_set_delete",
          "resume_interrupted",
          "view_plan",
          "copy_id",
          "copy_path",
          "copy_resume_command",
          "copy_preview",
          "expand_collapse_all",
          "scan_work_status",
          "export",
          "note",
          "tags",
          "alias",
          "shift_up",
          "shift_down",
          "view_switch",
          "open_file",
          "open_dir",
          "open_ref",
          "timeline",
          "compare",
          "git_status",
          "cmd_palette",
          "new_session",
          "focus_window"
        ]
      },
      "type": "object"
    },
    "launchInPlace": {
      "type": "boolean"
    },
    "launch_mode": {
      "enum": [
        "in-place",
        "tab",
        "window",
        "pane"
      ],
      "type": "string"
    },
    "launch_sets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "session_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "max_sessions": {
      "type": "integer"
    },
    "model": {
      "type": "string"
    },
    "new_session_command": {
      "type": "string"
    },
    "notify_on_waiting": {
      "type": "boolean"
    },
    "pane_direction": {
      "enum": [
        "auto",
        "right",
        "down",
        "left",
        "up"
      ],
      "type": "string"
    },
    "preview_position": {
      "enum": [
        "right",
        "bottom",
        "left",
        "top"
      ],
      "type": "string"
    },
    "project_roots": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "redact_preview_secrets": {
      "type": "boolean"
    },
    "resume_session_command": {
      "type": "string"
    },
    "schemes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "background": {
            "type": "string"
          },
          "black": {
            "type": "string"
          },
          "blue": {
            "type": "string"
          },
          "brightBlack": {
            "type": "string"
          },
          "brightBlue": {
            "type": "string"
          },
          "brightCyan": {
            "type": "string"
          },
          "brightGreen": {
            "type": "string"
          },
          "brightPurple": {
            "type": "string"
          },
          "brightRed": {
            "type": "string"
          },
          "brightWhite": {
            "type": "string"
          },
          "brightYellow": {
            "type": "string"
          },
          "cursorColor": {
            "type": "string"
          },
          "cyan": {
            "type": "string"
          },
          "foreground": {
            "type": "string"
          },
          "green": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purple": {
            "type": "string"
          },
          "red": {
            "type": "string"
          },
          "selectionBackground": {
            "type": "string"
          },
          "white": {
            "type": "string"
          },
          "yellow": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "sessionAliases": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "sessionLaunches": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer"
          },
          "last": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "type": "object"
    },
    "sessionNotes": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "sessionTags": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "show_preview": {
      "type": "boolean"
    },
    "theme": {
      "type": "string"
    },
    "views": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "excluded_dirs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "favorites_only": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "pivot": {
            "enum": [
              "none",
              "folder",
              "repo",
              "branch",
              "date",
              "host"
            ],
            "type": "string"
          },
          "search": {
            "type": "string"
          },
          "show_hidden": {
            "type": "boolean"
          },
          "sort": {
            "enum": [
              "updated",
              "created",
              "turns",
              "name",
              "folder",
              "frecency"
            ],
            "type": "string"
          },
          "sort_order": {
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          },
          "time_range": {
            "enum": [
              "1h",
              "1d",
              "7d",
              "all"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "workspace_recovery": {
      "type": "boolean"
    },
    "yoloMode": {
      "type": "boolean"
    }
  },
  "title": "Dispatch config.json",
  "type": "object"
}
