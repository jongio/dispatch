---
interface Props {
  title: string;
  description: string;
  screenshotSrc?: string;
  screenshotAlt?: string;
  badge?: string;
}

const { title, description, screenshotSrc, screenshotAlt, badge } = Astro.props;
const base = import.meta.env.BASE_URL;
const hasSlot = Astro.slots.has('default');
const id = screenshotSrc && `preview-${screenshotSrc.replace(/[^a-zA-Z0-9]/g, '-')}`;
---

<div class="card feature-card">
  {screenshotSrc && (
    <div class="feature-card-img">
      <button class="screenshot-link screenshot-trigger" type="button" data-dialog={id}>
        <img src={`${base}screenshots/${screenshotSrc}`} alt={screenshotAlt || title} loading="lazy" />
      </button>
    </div>
  )}
  {!screenshotSrc && hasSlot && (
    <div class="feature-card-illustration">
      <slot />
    </div>
  )}
  <div class="card-body">
    <div class="feature-card-header">
      <h3>{title}</h3>
      {badge && <span class="badge">{badge}</span>}
    </div>
    <p>{description}</p>
  </div>
</div>

{screenshotSrc && (
  <dialog class="lightbox" id={id} aria-label="Image preview">
    <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
    <img src={`${base}screenshots/${screenshotSrc}`} alt={screenshotAlt || title} />
  </dialog>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('.feature-card .screenshot-trigger').forEach(trigger => {
    const dialog = document.getElementById(trigger.dataset.dialog || '') as HTMLDialogElement | null;
    if (!dialog) return;

    trigger.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => trigger.focus());
  });
</script>

<style>
  .feature-card {
    background: linear-gradient(180deg, var(--bg-card) 0%, rgba(22, 27, 34, 0.6) 100%);
  }

  .feature-card-img {
    background: var(--bg-tertiary);
    overflow: hidden;
  }

  .feature-card-img img {
    width: 100%;
    opacity: 0.9;
    transition: opacity 0.3s, transform 0.3s;
    cursor: zoom-in;
  }

  .feature-card:hover .feature-card-img img {
    opacity: 1;
    transform: scale(1.02);
  }

  .feature-card-illustration {
    background: var(--bg-tertiary);
    padding: var(--space-8) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 9rem;
  }

  .feature-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .feature-card h3 {
    font-size: var(--text-lg);
  }

  .feature-card p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
</style>
