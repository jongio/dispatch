{
  "name": "dispatch-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "astro check && playwright test",
    "test:e2e": "playwright test",
    "screenshots": "go run -tags screenshots ../cmd/screenshots --out public/screenshots && node ../cmd/screenshots/render.mjs public/screenshots",
    "screenshots:check": "node -e \"require('node:fs').rmSync('.screenshots-check',{recursive:true,force:true})\" && go run -tags screenshots ../cmd/screenshots --check --out .screenshots-check && node -e \"require('node:fs').rmSync('.screenshots-check',{recursive:true,force:true})\""
  },
  "dependencies": {
    "astro": "^7.2.0",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "playwright": "^1.62.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "volar-service-yaml": "0.0.71"
  }
}
