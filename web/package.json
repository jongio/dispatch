{
  "name": "dispatch-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "astro check && astro build && node scripts/run-playwright.mjs",
    "test:e2e": "astro build && node scripts/run-playwright.mjs",
    "screenshots": "go run -tags screenshots ../cmd/screenshots --out public/screenshots && node ../cmd/screenshots/render.mjs public/screenshots",
    "screenshots:check": "node scripts/check-screenshots.mjs"
  },
  "dependencies": {
    "astro": "^7.4.4",
    "marked": "^18.1.2",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
