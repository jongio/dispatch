{
  "name": "dispatch-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "astro check && astro build && node scripts/run-playwright.mjs",
    "test:e2e": "astro build && node scripts/run-playwright.mjs",
    "screenshots": "go run -tags screenshots ../cmd/screenshots --out public/screenshots && node ../cmd/screenshots/render.mjs public/screenshots",
    "screenshots:check": "node scripts/check-screenshots.mjs"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "marked": "^18.0.9",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "playwright": "^1.62.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "volar-service-yaml": "0.0.71"
  }
}
